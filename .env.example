# ==============================================================================
# OmniScout-TG: Media-Planning Decision Intelligence & Attribution Engine
# Environment Configuration Template (.env.example)
# Copy this file to .env and populate your credentials.
# NOTE: DO NOT COMMIT REAL CREDENTIALS OR TOKENS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. b.ai Unified AI Gateway (https://api.b.ai/v1)
# ------------------------------------------------------------------------------
# Optional API Key for b.ai gateway.
# When omitted, the system utilizes local EmbeddingGemma 2 + pure-Python BM25 ($0 cost).
B_AI_API_KEY=your_b_ai_api_key_here

# Base URL for b.ai gateway
B_AI_BASE_URL=https://api.b.ai/v1

# Model Identifiers
# Fast System 1 Decision Engine (POST /v1/decisions)
B_AI_JEV_MODEL=jev-latest
# Semantic Reasoning & Creative Rationales (POST /v1/chat/completions)
B_AI_DEEPSEEK_MODEL=deepseek-v4.1-flash

# Operational Limits & Network Resilience
B_AI_TIMEOUT_SECONDS=30.0
B_AI_MAX_RETRIES=3
B_AI_RETRY_BACKOFF=1.5

# ------------------------------------------------------------------------------
# 2. Telegram Native MTProto & Web Fallback ($0 Cost Discovery Engine)
# ------------------------------------------------------------------------------
# Telegram Developer credentials from https://my.telegram.org (Optional)
# Used for GetChannelRecommendationsRequest (Seed Graph Snowballing) & metric harvesting.
# When omitted, the client automatically falls back to public web preview scraping (t.me/s/{channel}).
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_PHONE=+989120000000
TELEGRAM_SESSION_NAME=omniscout_session

# ------------------------------------------------------------------------------
# 3. Optional External Intelligence Providers (Secondary / Fallback)
# ------------------------------------------------------------------------------
TGSTAT_API_KEY=your_tgstat_api_key_here
TGSTAT_BASE_URL=https://api.tgstat.ru
TGSTAT_TIMEOUT_SECONDS=30.0

TGMARKET_MCP_URL=https://tgmarket.io/mcp
TGMARKET_API_KEY=your_tgmarket_api_key_here
TGMARKET_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 4. Economics & Campaign Defaults
# ------------------------------------------------------------------------------
DEFAULT_TARGET_CAC=50.0
DEFAULT_CVR_EST=0.02
DEFAULT_CTR_MIN=0.01
DEFAULT_CTR_MAX=0.025
DEFAULT_RISK_BUFFER=0.15
TEST_RESERVE_PERCENTAGE=0.20

# ------------------------------------------------------------------------------
# 5. Application, Output & Logging Settings
# ------------------------------------------------------------------------------
# Enforces UTF-8 console and file encoding on Windows
PYTHONUTF8=1

# Runtime environment: development | testing | production
ENVIRONMENT=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log output format: text | json
LOG_FORMAT=text

# Output directory for generated media plans (.xlsx, .csv)
OUTPUT_DIR=output

# ------------------------------------------------------------------------------
# 6. Interface-specific Settings
# ------------------------------------------------------------------------------
# Interpreter of the venv that hosts SentenceTransformers + google/embeddinggemma-2
# (the dense half of the hybrid scorer). Leave unset to use the default path; if the
# path does not exist, dense scores fall back to a fixed baseline and BM25 still runs.
# EMBEDDING_PYTHON_PATH=C:\path\to\embeddinggemma2\.venv\Scripts\python.exe

